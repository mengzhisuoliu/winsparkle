<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- ASan is too broken on ARM64 or VS2022 to use. -->
    <EnableASAN Condition="'$(PlatformToolset)'=='v145' And '$(Platform)'!='ARM64'">true</EnableASAN>
    <CopyAsanBinariesToOutDir Condition="'$(EnableASAN)'=='true'">true</CopyAsanBinariesToOutDir>
    <LinkIncremental Condition="'$(EnableASAN)'=='true'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(EnableASAN)'=='true'">
    <ClCompile>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
